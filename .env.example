# ============================================================
# Telegram Shop Bot — Environment Variables
# Copy file này thành .env và điền giá trị thật.
# KHÔNG commit file .env (đã ignore trong .gitignore).
# ============================================================

# --- Bot Telegram (bắt buộc) ---
# Lấy từ @BotFather. Có thể chỉ cần BOT_TOKEN, TELEGRAM_BOT_TOKEN là alias.
BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram ID admin, phân tách bằng dấu phẩy. Lấy từ @userinfobot
ADMIN_IDS=123456789

# Chat ID nhận thông báo hệ thống (thường giống ADMIN_IDS đầu tiên)
TELEGRAM_CHAT_ID=123456789

# Channel nhận thông báo đơn hàng tự động (ID hoặc @username)
ORDER_NOTIFY_CHANNEL=@vpluschannelkh
# Bật/tắt độc lập thông báo đơn vào channel và tới người dùng bot.
ORDER_CHANNEL_NOTIFY_ENABLED=true
ORDER_BOT_BROADCAST_ENABLED=true

# Link channel hỗ trợ khách hàng — hiện nút trong tin nhắn giao hàng
SUPPORT_CHANNEL_URL=https://t.me/vpluschannelkh

# --- Cổng bắt buộc tham gia nhóm (onboarding) ---
# Khi bật, khách bấm /start phải chọn ngôn ngữ và tham gia nhóm trước khi dùng bot.
# REQUIRED_GROUP: @username kênh/nhóm. Bot PHẢI là admin của nhóm này để check được.
# Nếu bot không check được (chưa là admin), hệ thống cho qua để tránh khoá nhầm khách.
REQUIRED_GROUP=@vpluschannelkh
REQUIRED_GROUP_URL=https://t.me/vpluschannelkh
REQUIRE_GROUP_JOIN=true
# Bot PHẢI là admin của REQUIRED_GROUP để đọc được danh sách thành viên (getChatMember).
# GROUP_GATE_FAILOPEN=true: nếu bot không kiểm tra được thì CHO QUA (tránh khoá nhầm). Mặc định false = CHẶN.
# GROUP_GATE_ADMIN_BYPASS=true: admin luôn bỏ qua cổng. Mặc định false.
GROUP_GATE_FAILOPEN=false
GROUP_GATE_ADMIN_BYPASS=false

# --- Server ---
PORT=3001

# Banner ảnh hiện khi /start (URL ảnh hoặc để trống)
SHOP_BANNER_URL=

# Webhook URL (nếu deploy có domain HTTPS, ngược lại để trống = polling mode)
# Có thể ép polling bằng BOT_MODE=polling hoặc WEBHOOK_ENABLED=false.
BOT_MODE=polling
WEBHOOK_ENABLED=false
WEBHOOK_FALLBACK_POLLING=true
WEBHOOK_URL=

# Telegram transport. Keep-alive is disabled by default because stale TLS sockets
# can cause ECONNRESET/socket hang up during file uploads on Windows VPS.
TELEGRAM_KEEP_ALIVE=false
TELEGRAM_MAX_SOCKETS=16
TELEGRAM_SEND_RETRY_ATTEMPTS=6
TELEGRAM_DOCUMENT_RETRY_ATTEMPTS=2
TELEGRAM_IP_FAMILY=4

# --- Database (bắt buộc) ---
# MongoDB Atlas connection string. Bot CHẠY THỰC TẾ trên MongoDB qua adapter,
# KHÔNG phải Postgres dù schema.prisma khai báo postgresql.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=shopbottele
# DNS servers cho MongoDB (mặc định 8.8.8.8,1.1.1.1)
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Tài khoản ngân hàng nhận tiền (bắt buộc) ---
BANK_CODE=MB
BANK_NAME=MB Bank
BANK_ACCOUNT=0000000000
BANK_ACCOUNT_NAME=NGUYEN VAN A

# Hiển thị fallback ở trang shop khi BANK_* trống
DEFAULT_BANK_NAME=MB Bank
DEFAULT_BANK_ACCOUNT=0000000000
DEFAULT_BANK_OWNER=NGUYEN VAN A

# --- Auto-confirm thanh toán (chọn 1 hoặc cả 2) ---
# Cách 1: Bank polling (chủ động fetch lịch sử mỗi 5s)
MBBANK_API_TOKEN=your_mbbank_api_token
MBBANK_HISTORY_BASE=https://thueapibank.vn/historyapimbbank
# BANK_POLL_ENABLED=true
# BANK_POLL_INTERVAL_MS=5000

# Cách 2: IPN webhook từ Casso/SePay (push về POST /webhook/ipn)
# thuebankvn (đang dùng) verify bằng IPN_SECRET_TOKEN qua header secure-token/x-api-key.
# BẮT BUỘC nếu bật webhook: thiếu token thì /webhook/ipn trả 400 và từ chối mọi
# request thay vì bỏ qua xác thực (bỏ qua = ai cũng đặt được đơn PAID miễn phí).
IPN_SECRET_TOKEN=your_ipn_secret_token
# Chỉ dùng khi dev local: cho phép webhook chưa xác thực. TUYỆT ĐỐI không bật trên production.
# ALLOW_UNSIGNED_IPN=false
# --- SePay (bank dự phòng, chạy SONG SONG với thuebankvn) ---
# Cấu hình trong dashboard SePay:
#   Webhook URL: http://<domain-hoặc-IP>:3001/webhook/ipn?provider=sepay
#   Kiểu xác thực: API Key → header "Authorization: Apikey <KEY>"
# Dán chính KEY đó vào SEPAY_API_KEY để bot xác thực webhook SePay gửi tới.
# Để trống = chưa bật SePay (chỉ thuebankvn chạy). Có key = 2 nguồn cùng chạy, chống trùng.
SEPAY_API_KEY=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=

# Cách 3: USDT crypto auto-confirm
# Bot quy đổi VND -> USDT theo tỷ giá này, rồi thêm phần lẻ riêng cho từng đơn để tự khớp.
CRYPTO_PAY_ENABLED=true
CRYPTO_POLL_ENABLED=true
CRYPTO_POLL_INTERVAL_MS=15000
CRYPTO_AMOUNT_TOLERANCE=0.0000004
CRYPTO_EXPIRE_MINUTES=20
# true = tu cap nhat ty gia USDT/VND theo thi truong; CRYPTO_USD_VND_RATE chi la gia du phong.
CRYPTO_USD_VND_RATE_AUTO=true
CRYPTO_USD_VND_RATE=26500
CRYPTO_USD_CNY_RATE=7.25
CRYPTO_USD_VND_RATE_UPDATE_MS=300000
CRYPTO_MIN_DEPOSIT_USDT=1
TRC20_USDT_ADDRESS=
BEP20_USDT_ADDRESS=
TRONGRID_API_KEY=
# Xac nhan nap USDT doc tu lich su nap cua tai khoan Binance (MOI mang, 1 API) —
# thay cho BscScan. Vi vay *_USDT_ADDRESS phai la DIA CHI NAP CUA TAI KHOAN BINANCE do.
# API key chi can quyen doc (Enable Reading). KHONG bat rut tien / giao dich.
# Chua co key: BEP20 bi an khoi bot (khong co cach doi soat), TRC20 chay qua TronGrid.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Binance Pay (C2C) — LUONG TIEN RIENG, khong on-chain: khach chuyen noi bo trong
# Binance toi Pay ID cua shop. KHONG nam trong lich su nap on-chain o tren, nen
# can nguon doi soat rieng (thueapibank.vn doc lich su Binance Pay).
# Thieu mot trong hai khoa duoi thi nut Binance Pay bi an khoi bot.
# Luu y: Binance Pay KHONG mang noi dung chuyen khoan — bot khop don hoan toan
# bang so USDT le duy nhat, va khong hien QR (Pay ID khong quet duoc).
BINANCE_PAY_ID=
BINANCE_PAY_TOKEN=
BANK_AMOUNT_TOLERANCE_VND=0

# Tự giao lại đơn đã thanh toán nếu Telegram mất kết nối tạm thời.
DELIVERY_RECOVERY_ENABLED=true
DELIVERY_RECOVERY_INTERVAL_MS=60000
DELIVERY_RECOVERY_BATCH_SIZE=10
# Chỉ tự giao lại đơn PAID trong 7 ngày gần nhất; đơn cũ hơn xử lý thủ công.
DELIVERY_RECOVERY_MAX_AGE_HOURS=168

# --- Cửa hàng API key (GPT2API Admin Public API) ---
# Bật tính năng GIFTCODE tặng key + nút "Tạo API key" ở menu chính. Thiếu bất kỳ
# khoá nào trong 3 khoá đầu thì HAI NÚT ĐÓ TỰ ẨN khỏi menu (không hiện nút dẫn tới
# màn báo lỗi). Cấu hình được cả trong web admin (ưu tiên DB hơn ENV).
#
# Base URL của Admin Public API — LUÔN kết thúc bằng /api/admin-pub
GPT2API_BASE=https://api.example.com/api/admin-pub
# Token adm_* (tạo ở Admin Panel → Access Tokens, cần scope key:write + key:read).
# ⚠️ Token này tạo được API key trên tài khoản shop → giữ như mật khẩu, luân phiên 90 ngày.
GPT2API_ADMIN_TOKEN=
# user_id (bắt buộc khi POST /keys) — key tạo ra sẽ thuộc user này.
GPT2API_USER_ID=
# Endpoint khách dùng để gọi model. Bỏ trống = tự suy ra từ GPT2API_BASE (origin + /v1).
GPT2API_ENDPOINT=
# Danh sách model hiện trong hướng dẫn dùng key + gửi làm allowed_models.
GPT2API_MODELS=claude-opus-5,claude-opus-4-8,claude-opus-4-7,claude-sonnet-5,claude-sonnet-4-6,claude-haiku-4-5,claude-fable-5
# Model Fallback · Allowed Groups: dán group public_id, phân tách bởi dấu phẩy.
# ⚠️ Admin Public API KHÔNG có endpoint liệt kê group (catalog nằm ở route JWT
# /api/admin/model-groups) — phải lấy id ra ngoài băng rồi dán vào đây. ĐỂ TRỐNG là
# lựa chọn an toàn: bot bỏ hẳn field fallback_allowed_groups, server tự áp mọi group
# mà owner của key được dùng (fallback_order rỗng = auto theo thứ tự global).
GPT2API_FALLBACK_GROUPS=
# Link tài liệu hướng dẫn dùng key (nút "Tài liệu" sau khi giao key). Trống = ẩn nút.
GPT2API_DOC_URL=
# Trang khách tự xem mức sử dụng key. Trống = không hiện dòng này.
GPT2API_USAGE_URL=
# RPM / TPM / số ngày hết hạn cho key cấp ra. 0 = không đặt (TPM/ngày kế thừa group).
GPT2API_KEY_RPM=300
GPT2API_KEY_TPM=0
GPT2API_KEY_VALID_DAYS=0
# 'all' = không gửi allowed_models (key xài mọi model group cho phép). 'restrict' =
# giới hạn theo GPT2API_MODELS ở trên.
GPT2API_ALLOWED_MODELS_MODE=all
# Quy đổi token hiển thị → quota_limit gửi lên xpiki. xpiki lưu credit =
# quota_limit/10000 và panel hiện token = credit / <giá> × 1tr. Để "10M token" trên
# bot khớp "10M token" trong panel xpiki thì gửi quota_limit = token × giá / 100.
# giá = "Claude Opus 5 input price per 1M" trong panel xpiki (hiện 15). 0 = tắt quy đổi.
GPT2API_QUOTA_REF_PRICE=15
# Giá bán: USD cho mỗi 1 triệu token.
GPT2API_USD_PER_MTOKEN=0.01
# Các gói token bán sẵn (triệu token), phân tách bởi dấu phẩy.
GPT2API_BUY_PRESETS_M=100,200,400,600,800,1000
# Trần số token khách được tự nhập (triệu token). Bỏ trống = 1.000.000 (1 nghìn tỷ
# token, coi như không giới hạn). Đặt số dương để giới hạn lại, vd 2000 = tối đa 2B.
GPT2API_MAX_BUY_M=
# --- Phụ phí RPM & thời hạn (NHÂN vào giá token). Bỏ trống = dùng mặc định. ---
# Giá cuối = giá_token × hệ_số_RPM × hệ_số_ngày.
#   hệ_số_RPM  = 1 + (RPM vượt GPT2API_RPM_INCLUDED)/GPT2API_RPM_INCLUDED × RPM_SURCHARGE_PCT%
#   hệ_số_ngày = validDays>0 ? 1 + validDays/30 × DAY_SURCHARGE_PCT%  :  GPT2API_NO_EXPIRY_MULT
# TẤT CẢ các biến GPT2API_* dưới đây chỉnh được trong web admin (tab "Cửa hàng API
# key" → "Giá & giới hạn"), DB thắng ENV, KHÔNG cần restart. ENV chỉ là giá trị khởi tạo.
GPT2API_RPM_INCLUDED=300
GPT2API_RPM_SURCHARGE_PCT=20
GPT2API_DAY_SURCHARGE_PCT=5
GPT2API_NO_EXPIRY_MULT=1.5
# Nút RPM / số ngày bán sẵn (phân tách dấu phẩy). Bỏ trống = mặc định
# 100,300,600,1200 / 1,3,7,30,90,365. (Nút "Không hết hạn" luôn có sẵn.)
GPT2API_RPM_PRESETS=
GPT2API_DAYS_PRESETS=
# Miền quota random mặc định cho giftcode APIKEY (triệu token) + alpha (độ hiếm mốc
# cao). Mã giftcode "đóng băng" miền này lúc tạo nếu để trống ô quota.
GPT2API_FREE_MIN_M=3
GPT2API_FREE_MAX_M=50
GPT2API_FREE_ALPHA=2
# false = tắt hẳn tính năng (ẩn nút, chặn cả nút cũ còn trong lịch sử chat).
GPT2API_ENABLED=true

# --- Bảo mật ---
# Bảo vệ endpoint admin (/admin/seed, /api/admin/icon-overrides)
ADMIN_SECRET=change_me_to_a_random_string

# --- Liên hệ ---
ADMIN_TELEGRAM=your_username

# --- Đo tốc độ xử lý (debug lag) ---
# PERF_LOG=true bật log mili-giây mỗi lần bấm nút/lệnh. Chỉ log khi vượt ngưỡng
# PERF_LOG_MS (mặc định 500ms). Xem log qua: npx pm2 logs bot | grep PERF
PERF_LOG=false
PERF_LOG_MS=500

# --- Log bot phụ (tùy chọn) ---
# Tạo bot phụ và channel riêng để nhận log realtime
LOG_BOT_TOKEN=
LOG_CHANNEL_ID=

# --- Referral & limits ---
# LƯU Ý: 5 biến REFERRAL_* dưới đây giờ chỉnh được trong web admin
# (Mời bạn / Affiliate → tab "Cài đặt quà"). Bảng Setting THẮNG ENV và có hiệu lực
# ngay, không cần restart — mấy dòng này chỉ là giá trị mặc định khi Setting trống.
# Hoa hồng % mỗi đơn của người được mời. 0 = TẮT (mặc định hiện tại — chương trình
# mời bạn trả bằng API key chứ không phải tiền hoa hồng).
REFERRAL_COMMISSION=0
# Quà mời bạn: mời 1 người → CẢ NGƯỜI MỜI LẪN NGƯỜI ĐƯỢC MỜI nhận 1 API key.
# Quà phát khi người được mời qua xong onboarding (chọn ngôn ngữ + vào nhóm).
REFERRAL_REWARD_TOKENS_M=20   # số token mỗi key, đơn vị triệu. 0 = tắt hẳn quà
REFERRAL_REWARD_DAYS=1        # số ngày key sống. 0 = không hết hạn theo thời gian
REFERRAL_REWARD_RPM=100       # RPM của key quà. 0 = dùng RPM shop (GPT2API_KEY_RPM)
# Chỉ phát quà cho lượt mời tạo TỪ ngày này. Để trống = trả bù cho cả referral cũ
# (cẩn thận: mọi cặp giới thiệu từ trước sẽ nhận key ở lần /start kế tiếp).
REFERRAL_REWARD_SINCE=2026-09-02
BACKUP_DIR=./backups
MAX_BACKUPS=10
EXPORT_DIR=./exports

