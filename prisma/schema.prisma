// ⚠️ Cảnh báo: file này CHỈ là tài liệu mô tả schema cho dev đọc.
// Bot chạy thực tế trên MongoDB qua adapter ở src/lib/prisma.js
// (giả lập API của Prisma Client trên MongoClient).
// Đừng chạy `npx prisma migrate` hoặc `npx prisma db push` — không có tác dụng
// và có thể gây hiểu nhầm cho người mới.
//
// Khi đổi cấu trúc dữ liệu:
//   1. Cập nhật model ở dưới để document hiện trạng.
//   2. Cập nhật MODEL_COLLECTIONS, DEFAULTS, REF_ID_FIELDS trong src/lib/prisma.js
//      nếu cần thêm collection/field mới.
//   3. Viết script migrate dữ liệu trong scripts/ nếu cần đổi schema dữ liệu cũ.

// Prisma Schema for Telegram Shop Bot v3
// Full featured with VIP, Audit Logs, and more

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["bot"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// User model - tracks telegram users
model User {
  id           String    @id @default(cuid())
  telegramId   String    @unique
  username     String?
  firstName    String?
  language     String    @default("vi")
  referralCode String    @unique
  referredBy   String?
  balance      Int       @default(0)
  isBlocked    Boolean   @default(false)
  vipLevel     Int       @default(0)
  vipExpiresAt DateTime?
  totalSpent   Int       @default(0)
  notifyMutedUntil Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders           Order[]
  referralsGiven   Referral[] @relation("Referrer")
  referralReceived Referral?  @relation("Referee")

  @@index([telegramId])
  @@index([vipLevel])
  @@schema("bot")
}

// Category model - organize products
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  icon        String // Emoji icon
  iconEmojiId String? // Telegram custom emoji ID
  description String?
  imageFileId String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]

  @@index([order])
  @@index([isActive])
  @@schema("bot")
}

// Product model
model Product {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  description       String?
  note              String?  @db.Text
  price             Int
  vipPrice          Int?
  currency          String   @default("VND")
  deliveryMode      String
  payload           String?
  imageFileId       String?
  imageUrl          String?
  isActive          Boolean  @default(true)
  // unlisted=true: ẩn khỏi danh mục/menu/web shop nhưng VẪN mua được qua deep link
  // t.me/<bot>?start=product_<id>. Tách khỏi isActive để luồng mua hàng (~15 chỗ
  // check isActive) không phải sửa gì — hàng ẩn vẫn isActive=true.
  unlisted          Boolean  @default(false)
  stockAlertAt      Int      @default(5)
  autoDisableAt     Int      @default(0)
  autoHideWhenEmpty Boolean  @default(false)
  icon              String?
  iconEmojiId       String?
  soldFake          Int      @default(0)
  categoryId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category   Category?   @relation(fields: [categoryId], references: [id])
  stockItems StockItem[]
  orders     Order[]

  @@index([categoryId])
  @@schema("bot")
}

// StockItem model
model StockItem {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  content   String
  isSold    Boolean   @default(false)
  soldAt    DateTime?
  orderId   String?
  createdAt DateTime  @default(now())

  @@index([productId, isSold])
  @@schema("bot")
}

// Order model
model Order {
  id               String    @id @default(cuid())
  oderId           String?
  odelegramId      String
  chatId           String
  productId        String
  quantity         Int
  amount           Int
  discount         Int       @default(0)
  finalAmount      Int
  currency         String    @default("VND")
  status           String    @default("PENDING")
  paymentMethod    String?
  paymentRef       String?
  cryptoNetwork    String?
  cryptoAmount     Float?
  cryptoAddress    String?
  cryptoToken      String?
  cryptoUsdVndRate Int?
  displayCurrency  String?
  displayUnitPrice Float?
  displayFinalUsd  Float?
  deliveryRef      String?
  deliveryContent  String?   @db.Text
  deliveryError    String?
  deliveryRetryBlockedAt DateTime?
  canceledAt       DateTime?
  cancelReason     String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id])
  coupon  Coupon? @relation(fields: [couponId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  couponId String?
  userId   String?

  @@index([odelegramId])
  @@index([status])
  @@index([createdAt])
  @@schema("bot")
}

// Coupon model
model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  discount     Int
  discountType String    @default("PERCENT")
  maxUses      Int?
  usedCount    Int       @default(0)
  minOrder     Int?
  maxDiscount  Int?
  vipOnly      Int       @default(0)
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  orders Order[]

  @@index([code])
  @@schema("bot")
}

// Giftcode model — mã quà tặng. Hai loại phần thưởng:
//   rewardType=WALLET → cộng `amount` VND vào ví
//   rewardType=APIKEY → cấp API key sk-* miễn phí, quota random có trọng số
//                       trong [quotaMinM, quotaMaxM] triệu token (số lớn hiếm hơn)
model GiftCode {
  id           String    @id @default(cuid())
  code         String    @unique
  rewardType   String    @default("WALLET") // WALLET | APIKEY
  amount       Int       @default(0) // WALLET: số tiền cộng vào ví (VND)
  quotaMinM    Int       @default(0) // APIKEY: quota tối thiểu (triệu token)
  quotaMaxM    Int       @default(0) // APIKEY: quota tối đa (triệu token)
  quotaAlpha   Float     @default(0) // APIKEY: số mũ luật lũy thừa; 0 = dùng mặc định
  keyRpm       Int       @default(0) // APIKEY: RPM của key; 0 = theo config chung
  keyValidDays Int       @default(0) // APIKEY: số ngày hết hạn; 0 = không hết hạn theo thời gian
  maxUses      Int? // null = không giới hạn tổng số lần dùng
  usedCount    Int       @default(0)
  perUserLimit Int       @default(1) // Số lần một user được đổi mã này
  vipOnly      Int       @default(0)
  expiresAt    DateTime?
  note         String? // Ghi chú hiện cho khách sau khi đổi thành công
  createdBy    String? // Telegram ID của admin tạo mã
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  redemptions GiftCodeRedemption[]

  @@index([code])
  @@index([isActive, createdAt])
  @@schema("bot")
}

// Lịch sử đổi giftcode — redeemKey UNIQUE là hàng rào chống đổi lại/double-submit.
// Xoá GiftCode KHÔNG xoá các bản ghi này: chúng là chứng từ đối soát số tiền đã
// cộng vào ví khách (adapter Mongo cũng không cascade).
model GiftCodeRedemption {
  id            String   @id @default(cuid())
  giftCodeId    String
  giftCode      GiftCode @relation(fields: [giftCodeId], references: [id])
  telegramId    String
  redeemKey     String   @unique // `{giftCodeId}:{telegramId}:{lần thứ n}`
  rewardType    String   @default("WALLET")
  amount        Int      @default(0) // WALLET: số tiền đã cộng
  quotaTokens   Int      @default(0) // APIKEY: quota đã random ra
  status        String   @default("PENDING") // PENDING → SUCCESS
  transactionId String? // WalletTransaction đã cộng tiền (WALLET)
  issuedKeyId   String? // IssuedApiKey đã cấp (APIKEY)
  createdAt     DateTime @default(now())

  @@index([giftCodeId, telegramId])
  @@schema("bot")
}

// Key API đã cấp cho khách (từ giftcode hoặc mua) — nguồn cho /mykey.
// Collection riêng, không dùng Setting JSON: hai lần cấp key đồng thời sẽ ghi đè
// nhau trong một document JSON và làm mất key của khách.
model IssuedApiKey {
  id          String    @id @default(cuid())
  telegramId  String
  key         String // sk-... plaintext; GPT2API cho đọc lại nên lưu để khách xem
  quotaTokens Int
  rpm         Int       @default(0)
  source      String    @default("PURCHASE") // GIFTCODE | PURCHASE | ADMIN
  giftCodeId  String? // nếu đến từ giftcode
  orderId     String? // nếu đến từ đơn mua
  priceUsd    Float?
  externalId  String? // id key phía GPT2API
  models      String[]
  expiresAt   DateTime?
  // "Server" (profile) đã cấp key này — cùng một kết nối GPT2API nhưng khác nhóm
  // model fallback. null = key cấp trước khi có nhiều server (coi như profile 1).
  profileId   Int?
  profileName String?
  createdAt   DateTime  @default(now())

  @@index([telegramId, createdAt])
  @@index([orderId])
  @@schema("bot")
}

// Referral model
model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("Referrer", fields: [referrerId], references: [id])
  refereeId  String   @unique
  referee    User     @relation("Referee", fields: [refereeId], references: [id])
  orderId    String?
  commission Int      @default(0)
  status     String   @default("PENDING")
  // Mốc đã phát quà giới thiệu (API key miễn phí) cho từng bên — null = chưa phát.
  // Dùng làm khoá chống phát trùng, xem grantReferralReward() trong src/referral.js.
  rewardRefereeAt  DateTime?
  rewardReferrerAt DateTime?
  createdAt  DateTime @default(now())

  @@index([referrerId])
  @@schema("bot")
}

// Settings model
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@schema("bot")
}

// Backup log
model BackupLog {
  id        String   @id @default(cuid())
  filename  String
  size      Int
  createdAt DateTime @default(now())

  @@schema("bot")
}

// Audit Log - tracks all admin actions
model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@schema("bot")
}

// VIP Level configuration
model VipLevel {
  id              String  @id @default(cuid())
  level           Int     @unique
  name            String
  minSpent        Int
  discountPercent Int     @default(0)
  referralBonus   Int     @default(0)
  benefits        String?

  @@schema("bot")
}

// Broadcast message
model Broadcast {
  id        String   @id @default(cuid())
  message   String
  sentCount Int      @default(0)
  failCount Int      @default(0)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@schema("bot")
}

// Wallet - internal balance for each user
model Wallet {
  id          String   @id @default(cuid())
  odelegramId String   @unique
  balance     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]

  @@index([odelegramId])
  @@schema("bot")
}

// Wallet Transaction - tracks all balance changes
model WalletTransaction {
  id               String   @id @default(cuid())
  walletId         String
  type             String // DEPOSIT, PURCHASE, REFUND, REFUND_REVERSAL, ADMIN_ADD, ADMIN_DEDUCT, GIFTCODE
  amount           Int
  balanceBefore    Int
  balanceAfter     Int
  description      String?
  status           String   @default("PENDING") // PENDING, SUCCESS, FAILED, EXPIRED
  orderId          String?
  paymentRef       String? // For deposit: bank transfer reference
  reversalOfId     String?  @unique
  refundKey         String?  @unique
  reversedAt       DateTime?
  reversedBy       String?
  reversalTransactionId String?
  cryptoNetwork    String?
  cryptoAmount     Float?
  cryptoAddress    String?
  cryptoToken      String?
  cryptoUsdVndRate Int?
  expiresAt        DateTime?
  createdAt        DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@schema("bot")
}
