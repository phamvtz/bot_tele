# .env.botapi.example
# Lấy api_id và api_hash tại: https://my.telegram.org -> API development tools
# Phân quyền trên VPS: chmod 600 .env.botapi
# TUYỆT ĐỐI KHÔNG commit file này vào Git hoặc chia sẻ công khai!

TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Bật local mode (cho phép upload file đến 2GB, đường dẫn file tuyệt đối)
TELEGRAM_LOCAL=1
